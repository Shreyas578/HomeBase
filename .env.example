# ==============================================================================
# HOMEBASE - Environment Variables Configuration
# Copy this file to .env.local and populate your API keys.
# ==============================================================================

# 1. Qloo Hackathon API Key (MANDATORY for live taste graph calls)
# Base URL used: https://hackathon.api.qloo.com (Header: X-Api-Key)
QLOO_API_KEY=your_qloo_hackathon_api_key_here

# 2. LLM Provider Key (Google Gemini Free Tier recommended, or Groq / OpenRouter)
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default LLM Provider: 'gemini' | 'groq' | 'openrouter' | 'mock'
LLM_PROVIDER=gemini

# 3. OpenStreetMap / Nominatim Configuration
# Identify your application as requested by OSM Nominatim usage policy (max 1 req/sec)
NOMINATIM_USER_AGENT=Homebase-Student-Agent-App/1.0 (contact: info@homebase-app.dev)

# 4. MySQL Database Configuration
# Localhost MySQL:
DATABASE_URL=mysql://root:password@localhost:3306/homebase
# Production (Aiven MySQL Free Tier):
# DATABASE_URL=mysql://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?ssl-mode=REQUIRED

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

